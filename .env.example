# Copy this file to `.env` and fill in your keys. Loaded automatically by latentsync/tts/factory.py.

# ---- TTS default provider (vbee / ausynclab / autovoice / api / local) ----
DEFAULT_TTS_PROVIDER=vbee
TTS_SPEED=1.2                                  # tốc độ đọc chung; provider riêng để trống sẽ dùng giá trị này

# ---- Vbee AI Voice (async: POST job -> poll -> download mp3). Cần CẢ App ID + Access Token ----
VBEE_APP_ID=                                   # UUID, vd ff6f220b-dd63-44fb-b233-e045fde8a2ef
VBEE_TOKEN=                                    # Access Token (JWT) — bí mật, KHÔNG commit
VBEE_DEFAULT_VOICE=hn_female_ngochuyen_full_48k-fhg
VBEE_WEBHOOK_URL=https://example.com/vbee-callback   # bắt buộc bởi API (ta poll, không dùng webhook)
# VBEE_SPEED=                                  # tốc độ riêng Vbee; trống = dùng TTS_SPEED
# VBEE_TIMEOUT=60                               # giây, chờ poll job xong
# VBEE_OUTPUT_FORMAT=mp3
# VBEE_API_URL=https://api.vbee.vn/v1/tts       # override nếu cần
# VBEE_STATUS_URL=https://api.vbee.vn/v1/tts/requests
# VBEE_VOICES_URL=https://vbee.vn/api/public/v1/voices

# ---- Audiosynclab (AusyncLab) — auth header X-API-Key, async create -> poll -> download ----
AUSYNCLAB_API_KEY=                             # ak_xxxxxxxx (Master hoặc Sub key)
AUSYNCLAB_DEFAULT_VOICE=                        # voice_id (lấy từ nút "Kết nối & tải giọng")
AUSYNCLAB_API_URL=https://api.ausynclab.io/api/v1
# AUSYNCLAB_LANGUAGE=vi
# AUSYNCLAB_MODEL=myna-1-turbo                 # Myna v1 Pro Fast trên web AusyncLab
# AUSYNCLAB_SPEED=                             # tốc độ riêng AusyncLab; trống = dùng TTS_SPEED (0.75-1.25)
# AUSYNCLAB_TIMEOUT=180                         # tổng thời gian chờ job TTS hoàn tất
# AUSYNCLAB_REQUEST_TIMEOUT=90                  # timeout từng request HTTP
# --- override path khi có doc TTS chính thức ---
# AUSYNCLAB_TTS_PATH=/speech/text-to-speech
# AUSYNCLAB_GET_PATH=/speech/{id}
# AUSYNCLAB_VOICES_PATH=/voices

# ---- Voice he thong (voice.autovideo.vn) ----
AUTOVOICE_API_KEY=                             # gửi qua header X-API-Key
AUTOVOICE_DEFAULT_VOICE=                        # voice_name
AUTOVOICE_URL=https://voice.autovideo.vn/v1/tts
# AUTOVOICE_VOICES_URL=https://voice.autovideo.vn/v1/voices
# AUTOVOICE_SPEED=                              # tốc độ riêng Voice hệ thống; trống = dùng TTS_SPEED
# AUTOVOICE_TIMEOUT=60

# ---- Generic online API (OpenAI TTS / ElevenLabs) ----
TTS_API_KEY=
TTS_API_URL=https://api.openai.com/v1/audio/speech
TTS_API_TYPE=openai           # openai / elevenlabs
TTS_API_DEFAULT_VOICE=alloy
# TTS_API_MODEL=tts-1

# ---- Local offline TTS (Piper / Coqui) ----
LOCAL_TTS_ENGINE=piper        # piper / coqui
LOCAL_TTS_MODEL_PATH=models/tts/vi_VN
LOCAL_TTS_DEFAULT_VOICE=vi_VN-thuy-medium

# ---- Google Drive auto-upload (render xong worker tự đẩy video lên thư mục Drive) ----
# Setup: đặt file JSON của Google vào secrets/ rồi chạy:
#   python google_drive_upload.py --extract secrets/<file>.json   # bóc secret vào .env
#   python google_drive_upload.py --auth    # chỉ OAuth: lấy refresh token 1 lần qua trình duyệt
#   python google_drive_upload.py --check   # kiểm tra credentials + quyền vào thư mục
GOOGLE_DRIVE_UPLOAD_ENABLED=0                  # 1 = bật auto-upload trong queue_worker
GOOGLE_DRIVE_FOLDER_ID=                        # ID thư mục: drive.google.com/drive/folders/<ID> (dán cả URL cũng được)
# Cách A — OAuth client (Gmail cá nhân — khuyên dùng; file thuộc tài khoản của bạn)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=                    # bí mật, KHÔNG commit
GOOGLE_DRIVE_REFRESH_TOKEN=                    # tự điền bởi --auth, KHÔNG commit
GOOGLE_DRIVE_PROJECT_ID=
GOOGLE_DRIVE_REDIRECT_URI=
# Cách B — Service Account (tự điền bởi --extract; nhớ share thư mục cho SA email quyền Editor)
GOOGLE_DRIVE_SA_CLIENT_EMAIL=
GOOGLE_DRIVE_SA_PRIVATE_KEY=                   # bí mật, KHÔNG commit
# Fallback: trỏ thẳng file JSON nếu chưa bóc vào env (file nằm trong secrets/ — đã gitignore)
GOOGLE_DRIVE_CREDENTIALS_JSON=secrets/google_drive.json
