{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "byscom-render-desktop",
  "version": "1.3.4",
  "identifier": "vn.byscom.render",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Byscom Render",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Video",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": ["resources/rendervideo-src.tar.gz"],
    "linux": {
      "deb": {
        "depends": ["ffmpeg", "python3", "policykit-1"],
        "desktopTemplate": "../templates/byscom-render-desktop.desktop.hbs"
      }
    }
  }
}
