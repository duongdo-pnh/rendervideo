# Rust build artifacts (6GB+, regenerated by `cargo build` / `tauri build`)
/src-tauri/target/

# Tauri-generated capability schemas (regenerated on build)
/src-tauri/gen/schemas/

# Bundled Python source tarball — regenerated by scripts/bundle-source.sh
/src-tauri/resources/rendervideo-src.tar.gz

# JS deps for the @tauri-apps/cli devDependency
node_modules/

# Rust build artifacts from the Ubuntu 22.04 Docker build (1.4GB+, see
# scripts/docker-build-deb.sh) — the container writes here, not target/
/src-tauri/target-jammy/
